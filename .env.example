# ---- Access -----------------------------------------------------------------
# Shared password for the whole app (dashboard + entry page). Leave empty to disable the login.
APP_PASSWORD=
APP_SESSION_SALT=change-me

# ---- Ad spend + lead results: Meta Marketing API -----------------------------
# System User token (Business Settings → Users → System users → Generate token, ads_read)
META_ACCESS_TOKEN=
# Homefield Turf = 1283686466948265, Spencer Homefield = 919742090786204
META_AD_ACCOUNT_IDS=1283686466948265,919742090786204
# META_API_VERSION=v21.0

# ---- Leads: GoHighLevel (preferred — counts every new contact) ---------------
# Settings → Private Integrations → token with contacts.readonly
GHL_API_KEY=
GHL_LOCATION_ID=
# GHL_LEAD_TAG=            # optional: only count contacts with this tag

# ---- Demos + revenue: SmartWater ---------------------------------------------
# Until these are set, demos and revenue are typed in on the entry page.
SMARTWATER_API_URL=
SMARTWATER_API_KEY=

# ---- Storage for manual entries: Upstash Redis (Vercel Marketplace) ----------
# Injected automatically by the Vercel integration; either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Misc -------------------------------------------------------------------
# BUSINESS_TZ=America/Chicago
# SOURCE_CACHE_SECONDS=600
# Show made-up numbers so the UI can be previewed with no keys:
DEMO_MODE=1
